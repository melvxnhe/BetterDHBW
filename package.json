{
  "name": "dhbw-mannheim-stundenplan",
  "version": "1.0.0",
  "private": true,
  "description": "Stundenpläne aller Kurse der DHBW Mannheim, aus Rapla gebaut.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:offline": "node build.mjs --offline",
