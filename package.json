    "db:migrate": "node scripts/migrate.mjs",
    "test": "node --test tests/"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "nodemailer": "10.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11"
  }
}
