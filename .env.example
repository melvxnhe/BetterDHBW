# Copy to .env for local use; on Vercel the same names go under
# Project → Settings → Environment Variables (Neon sets DATABASE_URL itself).
# Without DATABASE_URL, `npm start` uses a local database in .data/ instead.

# Neon Postgres connection string
DATABASE_URL=postgres://USER:PASSWORD@HOST/neondb?sslmode=require

# E-mails (confirmation and password reset), one of:
# a) Gmail: your address and a Google app password (myaccount.google.com/apppasswords)
SMTP_USER=dein.name@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
# other SMTP servers: SMTP_HOST, SMTP_PORT (465 = TLS, 587 = STARTTLS)
# b) resend.com with a verified domain:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Sender shown in the mail (default: "Stundenplan DHBW Mannheim <SMTP_USER>")
# MAIL_FROM=Stundenplan <noreply@example.org>

# Where links in e-mails point (on Vercel the production URL is used by default)
APP_URL=https://betterdhbw.vercel.app

# The chat: people without an account may write as "Gast 1234" (handy for
# testing). Set to off once only signed-in users should write.
# CHAT_GUESTS=off

# Who may register (default: both DHBW Mannheim domains)
# ALLOWED_EMAIL_DOMAINS=student.dhbw-mannheim.de,dhbw-mannheim.de
